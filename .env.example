# ──────────────────────────────────────────────
# Variabili d'ambiente KLR
#
# In sviluppo: copiare in .env.local e adattare.
# In produzione vivono in /srv/klr/klr.env sul VPS, lette da systemd.
# ──────────────────────────────────────────────

# Dati. Devono stare FUORI dall'albero del codice: altrimenti un deploy
# sovrascriverebbe i contenuti modificati dal CMS.
DATABASE_PATH=./data/klr.db
MEDIA_DIR=./data/media

# Auth.js — firma e cifratura dei cookie di sessione.
# Generare con: openssl rand -base64 32
# Cambiarlo invalida tutte le sessioni attive.
AUTH_SECRET=

# Origine pubblica del sito. In sviluppo si può omettere; dietro reverse
# proxy è necessaria, altrimenti Auth.js costruisce i redirect
# sull'indirizzo interno (localhost:3000) e il login non torna indietro.
# Da aggiornare quando si punta il dominio definitivo.
# AUTH_URL=https://klr-europe.com
